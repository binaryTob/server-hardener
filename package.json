{
  "name": "server-hardener",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive, read-only-first server hardening framework. Phase 1: discovery and inventory.",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json",
    "collect": "bun run scripts/collect.ts"
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@types/node": "^24.7.0",
    "bun-types": "^1.4.1",
    "typescript": "^5.9.3"
  }
}
