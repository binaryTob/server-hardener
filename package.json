{
  "name": "server-hardener",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local OpenCode agent for SSH-based Linux discovery, risk assessment and verified hardening with remote backups.",
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json",
    "inspect": "bun run scripts/inspect.ts"
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@types/node": "^24.7.0",
    "bun-types": "^1.4.1",
    "typescript": "^5.9.3"
  }
}
